{
    "name": "conquer/select2",
    "description": "Yii2 Select2 widget",
    "keywords": [
        "yii2",
        "extension",
        "widget",
        "select2"
    ],
    "homepage": "https://github.com/borodulin/yii2-select2",
    "type": "yii2-extension",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/borodulin/yii2-select2/issues",
        "source": "https://github.com/borodulin/yii2-select2"
    },
    "authors": [
        {
            "name": "Andrey Borodulin",
            "email": "borodulin@gmail.com"
        }
    ],
    "extra": {
        "branch-alias": {
            "dev-master": "1.7.x-dev"
        }
    },
    "require": {
        "php": "^7.4 || ^8.0",
        "yiisoft/yii2": "^2.0.6",
        "conquer/helpers": "^2.0.7",
        "bower-asset/select2": "^4.0.0"
    },
    "suggest": {
        "yiisoft/yii2-bootstrap": "Bootstrap 3 theme for the widget, together with bower-asset/select2-bootstrap-theme",
        "bower-asset/select2-bootstrap-theme": "Bootstrap 3 theme for the widget (only beta releases exist: require it as ^0.1@beta)"
    },
    "autoload": {
        "psr-4": {
            "conquer\\select2\\": ""
        }
    }
}
